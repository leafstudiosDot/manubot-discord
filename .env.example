# Manubot for Discord - example environment file
# Copy to .env and fill in real values. Never commit .env.

# Discord bot token (required)
TOKEN=your_discord_bot_token

# Discord application ID (recommended)
APP_ID=your_discord_application_id

# Panel superadmin (required). Use a bcrypt hash instead of plaintext when possible.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_me_now
# SUPERADMIN_PASSWORD_HASH=$2b$12$...

# API / production process
# MANUBOT_ENV=production
# API_HOST=0.0.0.0
API_PORT=6540
# WEB_THREADS=16
# MANUBOT_GATEWAY_ENABLED=true

# SQLite database and backups. Docker Compose overrides these to /data.
DB_PATH=src/manubot.db
# BACKUP_DIR=src/backups
# BACKUP_RETENTION=5

# Session security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# CSRF_SECRET=
# SESSION_COOKIE_NAME=panel_session
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_TTL_HOURS=12

# Origins (comma-separated, scheme + host + optional port, no wildcards)
# TRUSTED_ORIGINS=https://panel.example.com
# WS_TRUSTED_ORIGINS=https://panel.example.com
# ALLOW_LOOPBACK_DEV_ORIGINS=false

# Only enable behind a reverse proxy that overwrites X-Forwarded-For/Proto.
# TRUST_PROXY_HEADERS=false

# Login rate limiting (temporary, never permanent account lockout)
# LOGIN_RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# Request and direct-message upload limits
# MAX_REQUEST_BYTES=33554432
# MAX_JSON_BYTES=65536
# MAX_DM_FILE_BYTES=8388608
# MAX_DM_ATTACHMENTS=10

# MouseTrap attachment caching
# MOUSETRAP_CDN_ALLOWLIST=cdn.discordapp.com,media.discordapp.net
# MOUSETRAP_MAX_ATTACHMENT_BYTES=8388608
# MOUSETRAP_MAX_MESSAGE_BYTES=25165824
# MOUSETRAP_MAX_ATTACHMENTS=10
# MOUSETRAP_MAX_CONCURRENT_DOWNLOADS=4
# MOUSETRAP_DOWNLOAD_TIMEOUT_SECONDS=20
# MOUSETRAP_CONNECT_TIMEOUT_SECONDS=5

# Data retention (0 disables pruning)
# EVENT_RETENTION_DAYS=0
# MOUSETRAP_LOG_RETENTION_DAYS=0
# AUDIT_LOG_RETENTION_DAYS=0

# Send HSTS only when the panel is served over HTTPS
# ENABLE_HSTS=false

# Logging
# LOG_LEVEL=info
